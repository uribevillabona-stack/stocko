{
  "name": "stocko",
  "version": "0.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "legal:licenses": "node scripts/third-party-licenses.mjs",
    "predev": "npm run legal:licenses",
    "dev": "next dev",
    "prebuild": "npm run legal:licenses",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/local-db.ts",
    "db:seed": "tsx --env-file=.env.local src/lib/db/seed.ts",
    "desktop:prepare": "node desktop/scripts/prepare.mjs",
    "desktop:dev": "npm --prefix desktop start",
    "desktop:dist": "npm run desktop:prepare && npm --prefix desktop run dist",
    "desktop:test": "node --test desktop/test/",
    "desktop:store": "npm run desktop:prepare && npm --prefix desktop run dist:store"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.64.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
