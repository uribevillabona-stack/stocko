# Base de datos. Neon en producción; Docker o Postgres embebido en local.
DATABASE_URL=postgres://stocko:stocko@localhost:5432/stocko
# Solo para pruebas automatizadas (Vitest). Se vacía y se migra sola.
DATABASE_URL_TEST=postgres://stocko:stocko@localhost:5433/stocko_test

# Better Auth
BETTER_AUTH_SECRET=cambia-esto-por-32-bytes-aleatorios
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cifrado de credenciales de WhatsApp (AES-256-GCM, 32 bytes en base64)
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Fotos de producto (opcional). Neon Object Storage es S3-compatible.
# Si estas variables están vacías (y no hay LOCAL_UPLOADS_DIR), el campo de foto no aparece.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=
NEON_STORAGE_BUCKET=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=

# Fotos en una carpeta local en vez de S3: para desarrollo o un servidor propio con disco.
# No la uses en Netlify (su disco es efímero): allí usa las variables NEON_STORAGE_*.
LOCAL_UPLOADS_DIR=.local/uploads

# Versión de la Graph API de Meta para WhatsApp Cloud API (opcional).
WHATSAPP_GRAPH_VERSION=v23.0

# Versión web: quién administra este sitio y cómo escribirle por temas de datos personales.
# Se muestran en /legal/privacidad. Complétalas antes de abrir el sitio a otras personas.
# Se leen al compilar: después de cambiarlas hay que volver a publicar.
LEGAL_OPERATOR=
LEGAL_CONTACT=

# Encabezado confiable con la IP del cliente (límite de intentos y auditoría).
# En Netlify déjalo vacío. Detrás de tu propio proxy, el que él escriba (p. ej. x-forwarded-for).
TRUSTED_IP_HEADER=
